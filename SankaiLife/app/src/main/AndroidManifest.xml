<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Calendrier : lecture seule, pour valoriser les événements terminés en
      progression. Sankai ne modifie jamais le calendrier et ne lit que les
      événements nécessaires, localement — aucun réseau.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
      Alarmes exactes : indispensable pour qu'un mémo demandé à 22h00 parte à
      22h00 et non vers 22h08. Sur Android 12+, l'utilisateur doit accorder
      l'autorisation ; sans elle l'app retombe sur une alarme approximative et
      le signale dans l'écran de diagnostic.
      USE_EXACT_ALARM n'est volontairement PAS déclaré : il est réservé aux
      réveils et agendas, et son usage ici ferait rejeter l'app du Play Store.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Mise à jour depuis les Releases GitHub. Android exige toujours une
      confirmation de l'utilisateur : cette permission autorise seulement à
      OUVRIR l'installateur, jamais à installer en silence.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      INTERNET et ACCESS_NETWORK_STATE ne servent qu'aux mises à jour depuis
      les Releases GitHub et aux liens externes (Ko-fi, site). Toute la
      progression, les mémos, le focus et l'apprentissage fonctionnent hors
      ligne.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Synthèse vocale. Depuis Android 11, une application ne voit les autres
      paquets que si elle les déclare : sans ce bloc, TextToSpeech ne trouve
      aucun moteur et l'écoute échoue en silence sur les appareils récents,
      alors qu'elle fonctionne en test sur les anciens.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SankaiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SANKAILIFE">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SANKAILIFE.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              « Partager vers Sankai Life », depuis n'importe quelle application.
              Le filtre text/plain existait deja ; il etait declare et rien ne le
              lisait, donc partager un texte ouvrait l'application et ne faisait
              rien du tout.

              Les types listes sont ceux que le partage produit reellement : un
              carnet de notes envoie du texte, un tableur du CSV, un
              gestionnaire de fichiers un octet-stream faute de mieux.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- « Ouvrir avec » depuis un gestionnaire de fichiers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
            </intent-filter>
        </activity>

        <!--
          Widget « Aujourd'hui » : la journée en un coup d'œil, sans ouvrir
          l'application. Les données affichées restent locales.
        -->
        <receiver
            android:name=".ui.widgets.AujourdhuiWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aujourdhui_info" />
        </receiver>

        <!--
          Permet à l'installateur Android de lire l'APK téléchargé dans le
          cache, sans exposer le reste du stockage de l'application.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Reçoit l'alarme d'un module mémo et envoie la phrase. -->
        <receiver
            android:name=".core.notifications.MemoAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sankailife.action.MEMO_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Rappel quotidien de révision. -->
        <receiver
            android:name=".core.notifications.RevisionAlarmReceiver"
            android:exported="false" />

        <!-- Mot du jour : une découverte quotidienne discrète. -->
        <receiver
            android:name=".core.notifications.MotDuJourAlarmReceiver"
            android:exported="false" />

        <!-- Reprend les catégories locales après une pause choisie. -->
        <receiver
            android:name=".core.notifications.NotificationResumeReceiver"
            android:exported="false" />

        <!--
          Reprogramme toutes les alarmes après un redémarrage, une mise à jour
          de l'app, ou un changement d'heure ou de fuseau horaire : Android
          efface les alarmes au boot et les instants calculés deviendraient
          faux après un changement de fuseau.
        -->
        <receiver
            android:name=".core.notifications.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Source Concentration : observe uniquement la fin d'un minuteur
          système pour la transformer en progression symbolique. Inactif tant
          que l'utilisateur n'a pas accordé l'accès aux notifications (réglage
          système) ET activé la Concentration dans les Paramètres. La
          permission BIND_NOTIFICATION_LISTENER_SERVICE est système : Sankai ne
          la demande jamais, seule l'utilisatrice peut l'accorder.
        -->
        <service
            android:name=".core.concentration.MinuteurListener"
            android:exported="true"
            android:label="@string/concentration_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
