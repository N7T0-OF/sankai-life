<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget « Aujourd'hui » : deux lignes d'information utiles, aucune décoration.
  Le fond et les couleurs sont posés par le provider selon le thème clair/sombre.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_today"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_cartes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_loading"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_memo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_loading"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
